# Supabase: Dashboard → Project Settings → API
# Database: Dashboard → Project Settings → Database → Connection string

# --- Supabase (Auth + API) ---

SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key

# --- Postgres (Alembic + backend DB access) ---

# Option A — Direct connection (IPv6 network required):
#   postgresql://postgres:your-password@db.your-project-ref.supabase.co:5432/postgres
#
# Option B — Session pooler (IPv4-compatible; use this on most home/office networks):
#   Dashboard → Connect → Method: "Session pooler" → port 5432
#   postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres
#
# Do NOT use the transaction pooler (port 6543) — Alembic migrations require a session connection.
# URL-encode special characters in the password.
DATABASE_URL=postgresql://postgres.your-project-ref:your-password@aws-0-region.pooler.supabase.com:5432/postgres

# --- OpenAI (needed once the LLM / embedding layer is wired up) ---

OPENAI_API_KEY=sk-your-openai-api-key
# All PydanticAI agents execute via the OpenAI Responses API. GPT-5.6 has reasoning
# on by default, and OpenAI rejects function tools (how PydanticAI implements typed
# output) alongside reasoning on /v1/chat/completions.
#
# Tiering: luna is the default everywhere; terra is used only where reasoning earns
# its token cost. Override per request from the UI model picker.
OPENAI_CHAT_MODEL=gpt-5.6-luna
# Comma-separated allowlist shown in the UI model picker
OPENAI_CHAT_MODELS=gpt-5.6-sol,gpt-5.6-terra,gpt-5.6-luna
# Embeddings are a separate model family — not part of the GPT-5.6 chat trio.
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
OPENAI_EMBEDDING_DIMENSIONS=1536
# PMP + consultant RFP: long-form, evidence-grounded, validation-retry loop, so
# reasoning pays for itself here. openai-api executes via the Responses provider.
PMP_MODEL_PROVIDER=openai-api
PMP_MODEL=gpt-5.6-terra
PMP_MODEL_LABEL=GPT-5.6 Terra (balanced)
# Cost Plan draft + narrative generation (own setting; no longer rides on OPENAI_CHAT_MODEL)
COST_PLAN_MODEL=gpt-5.6-luna

# --- Server ---

# Logging: INFO (default) or DEBUG for retrieval/agent/embed detail in this terminal
LOG_LEVEL=DEBUG
PUBLIC_APP_URL=http://localhost:5173

# Hybrid document compiler for evidence-grounded architect-PM Create PMP (default: true).
# Set false to use the legacy monolithic full-document LLM path for comparison/debugging.
PMP_HYBRID_COMPILER=true
# Max active project documents swept on taxonomy Update PMP refresh (default: 150)
PMP_SWEEP_MAX_DOCUMENTS=150

# Comma-separated browser origins allowed to call the API (CORS).
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:5174

# --- SiteWise ingestion / retrieval ---

# Supabase Storage bucket for hosted project file uploads (Dashboard → Storage → New bucket).
# Backend uses the service role key; browsers upload through FastAPI, not directly to Storage.
SUPABASE_STORAGE_BUCKET=project-files

# Defaults to ../data from the backend package. Override on a VPS if the corpus
# is mounted elsewhere.
DATA_DIR=../data
INGEST_EMBEDDING_BATCH_SIZE=64
INGEST_SUPPORTED_EXTENSIONS=.pdf,.docx,.md
RETRIEVAL_SEMANTIC_LIMIT=20
RETRIEVAL_FTS_LIMIT=20
RETRIEVAL_FINAL_LIMIT=10
RETRIEVAL_RRF_K=60
RETRIEVAL_NEIGHBOUR_BEFORE=1
RETRIEVAL_NEIGHBOUR_AFTER=1
ASSISTANT_CONTEXT_PASSAGE_LIMIT=6
ASSISTANT_PASSAGE_CONTENT_CHARS=800
OPENAI_RATE_LIMIT_MAX_RETRIES=5

# --- Billing / authorization ---

# Keep BILLING_PROVIDER=none locally unless you want billing gates enforced.
BILLING_PROVIDER=none

# Stripe is the hosted-product billing provider from Phase 7 onward.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
STRIPE_CHECKOUT_SUCCESS_PATH=/billing?checkout=success
STRIPE_PORTAL_RETURN_PATH=/billing


# --- Pi agent runtime ---

AGENT_RUNTIME_ENABLED=false
# Pi's OpenAI provider bills to AGENT_PLATFORM_API_KEY.
# On Windows, use the full path to pi.cmd if spawn fails with WinError 2:
# PI_BINARY_PATH=C:\Users\<you>\AppData\Roaming\npm\pi.cmd
PI_BINARY_PATH=pi
# Production pins this to the adapter bundled in the backend image. Leave blank
# locally to use the Pi MCP adapter installed in your Pi user configuration.
PI_MCP_ADAPTER_PATH=
PI_MODEL_PROVIDER=openai
PI_MODEL=gpt-5.6-terra
PI_MODEL_OPTIONS=openai:gpt-5.6-luna:Fast,openai:gpt-5.6-terra:Balanced,openai:gpt-5.6-sol:Complex
AGENT_PLATFORM_API_KEY=
AGENT_MCP_URL=http://127.0.0.1:8000/mcp
# Agent workspaces must live OUTSIDE the repo so Pi never discovers the repo's
# coding-agent AGENTS.md as its instructions.
# Defaults to <home>/.clerk/agent-workspaces; override only with a path
# outside any source checkout.
# AGENT_WORKSPACE_ROOT=
AGENT_MAX_CONCURRENT_TURNS=4
AGENT_TURN_TIMEOUT_SECONDS=180
AGENT_TURN_TOKEN_SECRET=replace-with-long-random-secret
AGENT_MONTHLY_TURN_QUOTA=500

# Official-source research. NSW legislation uses a keyless curated registry;
# Brave remains an optional broad-government-search provider.
AGENT_WEB_RESEARCH_ENABLED=false
WEB_SEARCH_PROVIDER=nsw_legislation
BRAVE_SEARCH_API_KEY=
WEB_SEARCH_MAX_RESULTS=6
WEB_FETCH_TIMEOUT_SECONDS=12
WEB_FETCH_MAX_BYTES=4194304

# Production uses a separate sitewise-worker service. Local dev can turn on the
# in-process worker when that is easier.
TENDER_WORKER_INPROC_ENABLED=false
TENDER_WORKER_POLL_SECONDS=2
TENDER_WORKER_CONCURRENCY=4
TENDER_JOB_MAX_ATTEMPTS=3
TENDER_JOB_BACKOFF_BASE_SECONDS=30
TENDER_JOB_STALE_LOCK_MINUTES=10

# Tender comparison model tiers: luna extracts line items at volume, terra is the
# cheap adjudicator (T2/T3 mapping, classification, silence), sol is the frontier
# adjudicator (T4 mapping, project taxonomy).
TENDER_MODEL_EXTRACT=gpt-5.6-luna
TENDER_MODEL_ADJUDICATE_SMALL=gpt-5.6-terra
TENDER_MODEL_ADJUDICATE_FRONTIER=gpt-5.6-sol
# Embeddings stay on the text-embedding family.
TENDER_EMBED_MODEL=text-embedding-3-small

# Core workflow worker (Project Plan, Cost Plan, file sort, consultant RFP).
# Production runs `python -m app.workflows.worker` as a separate service.
# Locally, enable in-process so chat-queued RFPs complete without a second terminal.
WORKFLOW_WORKER_INPROC_ENABLED=true
WORKFLOW_WORKER_POLL_SECONDS=1
WORKFLOW_WORKER_CONCURRENCY=2
WORKFLOW_WORKER_LEASE_SECONDS=90
WORKFLOW_WORKER_MAX_ATTEMPTS=3
# Keeps locally queued workflow runs away from the hosted deployment,
# which polls the same workflow_runs table.
WORKFLOW_QUEUE_SCOPE=dev
