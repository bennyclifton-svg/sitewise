{
  "$schema": "https://design-tokens.github.io/community-group/format/",
  "name": "Sitewise",
  "version": "1.0.0",
  "note": "Mirrors tokens.css exactly. If the two disagree, tokens.css is wrong — regenerate it from here.",

  "color": {
    "palette": {
      "void":      { "value": "#060608", "oklch": "oklch(12% 0.006 265)", "use": "Ground plane" },
      "panel":     { "value": "#131418", "oklch": "oklch(18% 0.008 265)", "use": "Lit surface" },
      "edge":      { "value": "#24262B", "oklch": "oklch(26% 0.010 265)", "use": "Rules, dividers" },
      "facetBlue": { "value": "#2F72C4", "oklch": "oklch(52% 0.130 258)", "use": "Primary action. The only accent." },
      "beam":      { "value": "#7FB0E4", "oklch": "oklch(72% 0.090 254)", "use": "Links, highlights" },
      "bone":      { "value": "#E8E8E4", "oklch": "oklch(92% 0.004 90)",  "use": "Type, inverse panels" }
    },
    "material": {
      "graphite": { "value": "#2C3037", "use": "Mark roof plane" },
      "carbon":   { "value": "#191C21", "use": "Mark wall plane" },
      "bone":     { "value": "#D6D6D0", "use": "Mark floor plane" },
      "glazing":  { "value": "#2F72C4", "use": "Mark glazed plane" }
    },
    "text": {
      "primary":   { "value": "#E8E8E4" },
      "secondary": { "value": "#B6B9BF" },
      "tertiary":  { "value": "#8F939B" },
      "quiet":     { "value": "#5C5F66" }
    },
    "status": {
      "positive": { "value": "oklch(62% 0.130 155)" },
      "caution":  { "value": "oklch(72% 0.140 75)" },
      "critical": { "value": "oklch(58% 0.170 27)" }
    }
  },

  "typography": {
    "family": {
      "sans": { "value": "Söhne", "fallback": "Hanken Grotesk, Helvetica, Arial, sans-serif", "licence": "commercial — Klim Type Foundry" },
      "mono": { "value": "Söhne Mono", "fallback": "IBM Plex Mono, ui-monospace, monospace", "licence": "commercial — Klim Type Foundry" },
      "display": { "value": "Expose", "fallback": "Hanken Grotesk, Helvetica, Arial, sans-serif", "licence": "FFL — Fontshare / Indian Type Foundry" }
    },
    "weight": { "display": 400, "body": 300, "medium": 400, "strong": 500 },
    "ramp": {
      "display": { "size": "clamp(52px, 8.2vw, 116px)", "leading": 0.94, "tracking": "-0.045em", "weight": 400, "family": "display" },
      "title":   { "size": "42px", "leading": 1.05, "tracking": "-0.04em",  "weight": 400, "family": "display" },
      "heading": { "size": "25px", "leading": 1.2,  "tracking": "-0.015em", "weight": 400 },
      "bodyLg":  { "size": "19px", "leading": 1.6,  "weight": 300 },
      "body":    { "size": "17px", "leading": 1.6,  "weight": 300 },
      "small":   { "size": "15px", "leading": 1.55, "weight": 300 },
      "label":   { "size": "11px", "tracking": "0.16em", "weight": 400, "transform": "uppercase", "family": "mono" }
    },
    "measure": { "value": "52ch", "note": "Hard cap on body line length." }
  },

  "space": {
    "base": 8,
    "scale": { "1": "8px", "2": "16px", "3": "26px", "4": "40px", "5": "56px", "6": "110px" },
    "sectionRhythm": "110px"
  },

  "radius": { "default": "0", "round": "999px", "note": "Square by default, matching the facets. Radius is reserved for avatars and status dots." },

  "motion": {
    "easing": {
      "enter":   { "value": "cubic-bezier(0.22, 1, 0.36, 1)", "duration": "420ms",  "use": "Reveals, panels, page transitions" },
      "state":   { "value": "cubic-bezier(0.4, 0, 0.2, 1)",   "duration": "180ms",  "use": "Hover, focus, colour and border shifts" },
      "ambient": { "value": "cubic-bezier(0.45, 0, 0.55, 1)", "duration": "9000ms", "use": "Light drift, sheen, breathing indicators" }
    },
    "stagger": "60ms",
    "rules": [
      "Opacity and transform only.",
      "Decelerative — things arrive, they never bounce.",
      "Honour prefers-reduced-motion."
    ]
  },

  "light": {
    "key": {
      "position": { "x": "42vw", "y": "30vh", "note": "Overwritten in px by the damped pointer loop." },
      "radius": "680px",
      "tint": "rgba(126, 168, 220, 0.13)",
      "angle": "~20° off the surface normal, above and to the left",
      "minBlur": "30px"
    },
    "edge": {
      "lit":       "rgba(255, 255, 255, 0.13)",
      "litRaised": "rgba(255, 255, 255, 0.26)",
      "side":      "rgba(255, 255, 255, 0.06)",
      "shade":     "rgba(0, 0, 0, 0.60)"
    },
    "contact":      "0 40px 60px -50px rgba(0,0,0,1)",
    "contactDeep":  "0 60px 90px -60px rgba(0,0,0,0.95)",
    "bounceMax":    0.08,
    "grainOpacity": 0.05,
    "rules": [
      "Elevation is luminance, never a drop shadow.",
      "Only the edge facing the key catches highlight.",
      "Surfaces darken where they meet — tight and opaque, not a soft offset glow.",
      "Saturated surfaces bleed their hue onto neighbours at 8% or less. Blue bounces; grey does not.",
      "Two elevation levels only."
    ]
  }
}
